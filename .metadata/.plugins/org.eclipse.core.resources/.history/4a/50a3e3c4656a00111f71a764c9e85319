/* USER CODE BEGIN 2 */

uint8_t check;
uint8_t Data;

HAL_I2C_Mem_Read(
        &hi2c2,
        MPU6050_ADDR,
        0x75,
        I2C_MEMADD_SIZE_8BIT,
        &check,
        1,
        100);

if(check == 0x68)
{
    printf("MPU6050 detectado\r\n");

    // PWR_MGMT_1 (0x6B)
    // Clock PLL con gyro Y y salir de sleep
    Data = 0x01;
    HAL_I2C_Mem_Write(
            &hi2c2,
            MPU6050_ADDR,
            0x6B,
            I2C_MEMADD_SIZE_8BIT,
            &Data,
            1,
            100);

    HAL_Delay(100);

    // GYRO_CONFIG (0x1B)
    // ±2000 °/s
    Data = 0x18;
    HAL_I2C_Mem_Write(
            &hi2c2,
            MPU6050_ADDR,
            0x1B,
            I2C_MEMADD_SIZE_8BIT,
            &Data,
            1,
            100);

    // ACCEL_CONFIG (0x1C)
    // ±2 g
    Data = 0x00;
    HAL_I2C_Mem_Write(
            &hi2c2,
            MPU6050_ADDR,
            0x1C,
            I2C_MEMADD_SIZE_8BIT,
            &Data,
            1,
            100);

    // USER_CTRL (0x6A)
    // Deshabilitar I2C Master Mode
    Data = 0x00;
    HAL_I2C_Mem_Write(
            &hi2c2,
            MPU6050_ADDR,
            0x6A,
            I2C_MEMADD_SIZE_8BIT,
            &Data,
            1,
            100);

    // INT_PIN_CFG (0x37)
    // Deshabilitar bypass
    Data = 0x00;
    HAL_I2C_Mem_Write(
            &hi2c2,
            MPU6050_ADDR,
            0x37,
            I2C_MEMADD_SIZE_8BIT,
            &Data,
            1,
            100);

    printf("Configuracion MPU6050 completa\r\n");
}
else
{
    printf("MPU6050 no encontrado\r\n");
}

/* USER CODE END 2 */
