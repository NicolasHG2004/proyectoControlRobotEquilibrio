/**
  * @brief  The application entry point.
  * @retval int
  */
int main(void)
{

  /* USER CODE BEGIN 1 */

  /* USER CODE END 1 */

  /* MCU Configuration--------------------------------------------------------*/

  /* Reset of all peripherals, Initializes the Flash interface and the Systick. */
  HAL_Init();

  /* USER CODE BEGIN Init */

  /* USER CODE END Init */

  /* Configure the system clock */
  SystemClock_Config();

  /* USER CODE BEGIN SysInit */

  /* USER CODE END SysInit */

  /* Initialize all configured peripherals */
  MX_GPIO_Init();
  MX_I2C2_Init();
  MX_USART1_UART_Init();
  /* USER CODE BEGIN 2 */
  uint8_t check;
  uint8_t Data;

  HAL_I2C_Mem_Read(
      &hi2c2,
      MPU6050_ADDR,
      0x75,
      I2C_MEMADD_SIZE_8BIT,
      &check,
      1,
      100
  );

  if(check == 0x68)
  {
      // 1. Despertar el sensor (PWR_MGMT_1)
      Data = 0;
      HAL_I2C_Mem_Write(&hi2c2, MPU6050_ADDR, 0x6B, I2C_MEMADD_SIZE_8BIT, &Data, 1, 100);

      // 2. Configurar Pin INT en modo LATCH (Se queda en bajo hasta leer)
      Data = 0x20; // Bit 5 activo (LATCH_INT_EN)
      HAL_I2C_Mem_Write(&hi2c2, MPU6050_ADDR, 0x37, I2C_MEMADD_SIZE_8BIT, &Data, 1, 100);

      // 3. Activar interrupción por datos listos (INT_ENABLE)
      Data = 0x01; // DATA_RDY_EN activo
      HAL_I2C_Mem_Write(&hi2c2, MPU6050_ADDR, 0x38, I2C_MEMADD_SIZE_8BIT, &Data, 1, 100);
  }
  /* USER CODE END 2 */

  /* Infinite loop */
  /* USER CODE BEGIN WHILE */
  while (1)
  {
    /* USER CODE END WHILE */

    // Comprobamos si el pin INT del MPU (PA12) bajó a 0V (Datos Listos)
    if (HAL_GPIO_ReadPin(GPIOA, GPIO_PIN_12) == GPIO_PIN_RESET)
    {
        // Al leer el registro 0x3B, el MPU6050 limpia automáticamente el pin INT y lo vuelve a subir a 3.3V
        HAL_I2C_Mem_Read(&hi2c2, MPU6050_ADDR, 0x3B,
            I2C_MEMADD_SIZE_8BIT, data, 14, 100);

        // Procesamiento de datos crudos (Raw)
        Accel_X_RAW = (int16_t)(data[0] << 8 | data[1]);
        Accel_Y_RAW = (int16_t)(data[2] << 8 | data[3]);
        Accel_Z_RAW = (int16_t)(data[4] << 8 | data[5]);
        int16_t Gyro_X_RAW = (int16_t)(data[8]  << 8 | data[9]);
        int16_t Gyro_Y_RAW = (int16_t)(data[10] << 8 | data[11]);
        int16_t Gyro_Z_RAW = (int16_t)(data[12] << 8 | data[13]);

        // Conversión acelerómetro → g (rango ±2g)
        float ax = Accel_X_RAW / 16384.0f;
        float ay = Accel_Y_RAW / 16384.0f;
        float az = Accel_Z_RAW / 16384.0f;

        // Conversión giroscopio → °/s (rango ±250°/s)
        float gx = Gyro_X_RAW / 131.0f;
        float gy = Gyro_Y_RAW / 131.0f;
        float gz = Gyro_Z_RAW / 131.0f;

        // Ángulo de inclinación desde acelerómetro (en grados)
        float angulo_x = atan2f(ay, az) * 180.0f / 3.14159f;
        float angulo_y = atan2f(ax, az) * 180.0f / 3.14159f;

        // Impresión a través del puerto Serial (USART1)
        char buf[120];
        int len = snprintf(buf, sizeof(buf),
            "Ax:%.2f Ay:%.2f Az:%.2f | Gx:%.1f Gy:%.1f Gz:%.1f | AngX:%.1f AngY:%.1f\r\n",
            ax, ay, az, gx, gy, gz, angulo_x, angulo_y);
        HAL_UART_Transmit(&huart1, (uint8_t*)buf, len, 200);
    }

    // Pequeña espera para aliviar el procesador si no hay lecturas pendientes
    HAL_Delay(5);
    /* USER CODE BEGIN 3 */
  }
  /* USER CODE END 3 */
}

