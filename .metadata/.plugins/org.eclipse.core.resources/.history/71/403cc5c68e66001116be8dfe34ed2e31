#include "mpu6050.h"

/* Sensibilidades según escala elegida */
static float accel_sensitivity = 16384.0f;  // LSB/g para ±2g
static float gyro_sensitivity  = 131.0f;    // LSB/(°/s) para ±250°/s

/* ---------- helpers internos ---------- */

static HAL_StatusTypeDef write_reg(I2C_HandleTypeDef *hi2c,
                                   uint8_t reg, uint8_t val)
{
    uint8_t buf[2] = {reg, val};
    return HAL_I2C_Master_Transmit(hi2c, MPU6050_ADDR, buf, 2, HAL_MAX_DELAY);
}

static HAL_StatusTypeDef read_regs(I2C_HandleTypeDef *hi2c,
                                   uint8_t reg, uint8_t *dst, uint16_t len)
{
    HAL_StatusTypeDef st;
    st = HAL_I2C_Master_Transmit(hi2c, MPU6050_ADDR, &reg, 1, HAL_MAX_DELAY);
    if (st != HAL_OK) return st;
    return HAL_I2C_Master_Receive(hi2c, MPU6050_ADDR, dst, len, HAL_MAX_DELAY);
}

/* ---------- API pública ---------- */

HAL_StatusTypeDef MPU6050_Init(I2C_HandleTypeDef *hi2c,
                                MPU6050_AccelScale ascale,
                                MPU6050_GyroScale  gscale)
{
    HAL_StatusTypeDef st;

    /* 1. Despertar el sensor (salir de sleep mode) */
    st = write_reg(hi2c, MPU6050_REG_PWR_MGMT_1, 0x00);
    if (st != HAL_OK) return st;
    HAL_Delay(100);

    /* 2. Divisor de muestreo: 0 → 1 kHz con DLPF activo */
    st = write_reg(hi2c, MPU6050_REG_SMPLRT_DIV, 0x07);
    if (st != HAL_OK) return st;

    /* 3. DLPF a ~94 Hz de ancho de banda */
    st = write_reg(hi2c, MPU6050_REG_CONFIG, 0x02);
    if (st != HAL_OK) return st;

    /* 4. Escala del giroscopio */
    st = write_reg(hi2c, MPU6050_REG_GYRO_CONFIG, (uint8_t)gscale);
    if (st != HAL_OK) return st;

    /* 5. Escala del acelerómetro */
    st = write_reg(hi2c, MPU6050_REG_ACCEL_CONFIG, (uint8_t)ascale);
    if (st != HAL_OK) return st;

    /* Guardar sensibilidades para la conversión */
    switch (ascale) {
        case ACCEL_SCALE_2G:  accel_sensitivity = 16384.0f; break;
        case ACCEL_SCALE_4G:  accel_sensitivity =  8192.0f; break;
        case ACCEL_SCALE_8G:  accel_sensitivity =  4096.0f; break;
        case ACCEL_SCALE_16G: accel_sensitivity =  2048.0f; break;
    }
    switch (gscale) {
        case GYRO_SCALE_250DPS:  gyro_sensitivity = 131.0f;  break;
        case GYRO_SCALE_500DPS:  gyro_sensitivity =  65.5f;  break;
        case GYRO_SCALE_1000DPS: gyro_sensitivity =  32.8f;  break;
        case GYRO_SCALE_2000DPS: gyro_sensitivity =  16.4f;  break;
    }

    return HAL_OK;
}

HAL_StatusTypeDef MPU6050_ReadAll(I2C_HandleTypeDef *hi2c, MPU6050_Data *data)
{
    uint8_t buf[14];
    HAL_StatusTypeDef st;

    /* Leer 14 bytes desde ACCEL_XOUT_H:
       [0-5]  acelerómetro X,Y,Z
       [6-7]  temperatura
       [8-13] giroscopio X,Y,Z */
    st = read_regs(hi2c, MPU6050_REG_ACCEL_XOUT_H, buf, 14);
    if (st != HAL_OK) return st;

    data->raw_ax = (int16_t)(buf[0]  << 8 | buf[1]);
    data->raw_ay = (int16_t)(buf[2]  << 8 | buf[3]);
    data->raw_az = (int16_t)(buf[4]  << 8 | buf[5]);
    int16_t raw_temp = (int16_t)(buf[6]  << 8 | buf[7]);
    data->raw_gx = (int16_t)(buf[8]  << 8 | buf[9]);
    data->raw_gy = (int16_t)(buf[10] << 8 | buf[11]);
    data->raw_gz = (int16_t)(buf[12] << 8 | buf[13]);

    /* Convertir a unidades físicas */
    data->accel_x = (data->raw_ax / accel_sensitivity) * 9.81f;
    data->accel_y = (data->raw_ay / accel_sensitivity) * 9.81f;
    data->accel_z = (data->raw_az / accel_sensitivity) * 9.81f;

    data->gyro_x = data->raw_gx / gyro_sensitivity;
    data->gyro_y = data->raw_gy / gyro_sensitivity;
    data->gyro_z = data->raw_gz / gyro_sensitivity;

    /* Fórmula del datasheet: Temp(°C) = raw/340 + 36.53 */
    data->temp_c = (raw_temp / 340.0f) + 36.53f;

    return HAL_OK;
}

HAL_StatusTypeDef MPU6050_WhoAmI(I2C_HandleTypeDef *hi2c, uint8_t *id)
{
    return read_regs(hi2c, MPU6050_REG_WHO_AM_I, id, 1);
    /* Debe devolver 0x68 si el sensor responde correctamente */
}
