/**
  * @brief  The application entry point.
  * @retval int
  */
int main(void)
{
  /* USER CODE BEGIN 1 */

  /* USER CODE END 1 */

  /* MCU Configuration--------------------------------------------------------*/

  /* Reset of all peripherals, Initializes the Flash interface and the Systick. */
  HAL_Init();

  /* USER CODE BEGIN Init */

  /* USER CODE END Init */

  /* Configure the system clock */
  SystemClock_Config();

  /* USER CODE BEGIN SysInit */

  /* USER CODE END SysInit */

  /* Initialize all configured peripherals */
  MX_GPIO_Init();
  MX_I2C2_Init();
  MX_USART1_UART_Init();
  /* USER CODE BEGIN 2 */
  uint8_t check = 0;
  uint8_t Data = 0;
  char init_buf[60];

  // Esperar un momento corto a que el MPU6050 se estabilice eléctricamente
  HAL_Delay(100);

  // 1. Leer el registro WHO_AM_I (0x75)
  HAL_I2C_Mem_Read(&hi2c2, MPU6050_ADDR, 0x75, I2C_MEMADD_SIZE_8BIT, &check, 1, 100);

  if(check == 0x68)
  {
      // Enviar mensaje de éxito por UART
      int init_len = snprintf(init_buf, sizeof(init_buf), "¡MPU6050 detectado con exito! Despertando...\r\n");
      HAL_UART_Transmit(&huart1, (uint8_t*)init_buf, init_len, 100);

      // 2. Despertar el sensor escribiendo 0x00 en PWR_MGMT_1 (0x6B)
      Data = 0x00;
      HAL_I2C_Mem_Write(&hi2c2, MPU6050_ADDR, 0x6B, I2C_MEMADD_SIZE_8BIT, &Data, 1, 100);
  }
  else
  {
      // Enviar mensaje de error por UART si no se encuentra el dispositivo
      int init_len = snprintf(init_buf, sizeof(init_buf), "ERROR: No se encontro MPU6050. Check devuelto: 0x%02X\r\n", check);
      HAL_UART_Transmit(&huart1, (uint8_t*)init_buf, init_len, 100);

      // Bloquear el programa aquí si hay error de hardware para evitar lecturas falsas
      while(1)
      {
          HAL_GPIO_TogglePin(GPIOB, GPIO_PIN_12); // Si tienes un LED de estado, parpadeará rápido
          HAL_Delay(200);
      }
  }
  /* USER CODE END 2 */

  /* Infinite loop */
  /* USER CODE BEGIN WHILE */
  while (1)
  {
      /* USER CODE END WHILE */

      /* USER CODE BEGIN 3 */
      // Leer los 14 registros de datos consecutivos del MPU6050 (Acelerómetro, Temperatura, Giroscopio)
      if (HAL_I2C_Mem_Read(&hi2c2, MPU6050_ADDR, 0x3B, I2C_MEMADD_SIZE_8BIT, data, 14, 100) == HAL_OK)
      {
          // Reconstruir los bytes (High Byte << 8 | Low Byte)
          Accel_X_RAW = (int16_t)(data[0] << 8 | data[1]);
          Accel_Y_RAW = (int16_t)(data[2] << 8 | data[3]);
          Accel_Z_RAW = (int16_t)(data[4] << 8 | data[5]);

          int16_t Gyro_X_RAW = (int16_t)(data[8]  << 8 | data[9]);
          int16_t Gyro_Y_RAW = (int16_t)(data[10] << 8 | data[11]);
          int16_t Gyro_Z_RAW = (int16_t)(data[12] << 8 | data[13]);

          // Conversión acelerómetro → g (rango por defecto ±2g)
          float ax = Accel_X_RAW / 16384.0f;
          float ay = Accel_Y_RAW / 16384.0f;
          float az = Accel_Z_RAW / 16384.0f;

          // Conversión giroscopio → °/s (rango por defecto ±250°/s)
          float gx = Gyro_X_RAW / 131.0f;
          float gy = Gyro_Y_RAW / 131.0f;
          float gz = Gyro_Z_RAW / 131.0f;

          // Calcular ángulos de inclinación basados en la gravedad
          float angulo_x = atan2f(ay, az) * 180.0f / 3.14159265f;
          float angulo_y = atan2f(ax, az) * 180.0f / 3.14159265f;

          // Formatear y enviar por el puerto serial (USART1)
          char buf[120];
          int len = snprintf(buf, sizeof(buf),
              "Ax:%.2f Ay:%.2f Az:%.2f | Gx:%.1f Gy:%.1f Gz:%.1f | AngX:%.1f AngY:%.1f\r\n",
              ax, ay, az, gx, gy, gz, angulo_x, angulo_y);
          HAL_UART_Transmit(&huart1, (uint8_t*)buf, len, 200);
      }
      else
      {
          char error_buf[40] = "Error leyendo datos I2C...\r\n";
          HAL_UART_Transmit(&huart1, (uint8_t*)error_buf, sizeof(error_buf), 100);
      }

      HAL_Delay(100); // Muestreo cada 100ms
  }
  /* USER CODE END 3 */
}

